# Copie para .env. Use senhas exclusivas de laboratório e não versione esse arquivo.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13307
MYSQL_DATABASE=securapy_gs
MYSQL_USER=operador
MYSQL_PASSWORD=troque-esta-senha-do-laboratorio
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-do-laboratorio
MONGO_URI=mongodb://127.0.0.1:27019/
MONGO_DATABASE=securapy_gs
LOG_TIMEZONE=America/Sao_Paulo
ALERTAS_HOST=127.0.0.1
ALERTAS_PORT=9999
ALERTAS_TOKEN=troque-por-um-token-aleatorio-com-32-caracteres
# --- Plataforma integrada (API, dashboard e Docker) ---
# Segredos com pelo menos 32 caracteres aleatórios; gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=troque-por-um-segredo-jwt-aleatorio-com-48-caracteres
SECRET_KEY=troque-por-uma-chave-de-sessao-flask-aleatoria-longa
# Administrador criado na primeira subida do contêiner (senha: 10 a 128 caracteres).
ADMIN_EMAIL=admin@securapy.test
ADMIN_PASSWORD=troque-esta-senha-do-admin
# 1 = consulta ipinfo.io para IPs públicos na busca por IP; 0 = desligado.
ENRIQUECER_IP=1
# Opcional: sem chave, o assistente funciona em modo mock (fallback por regras).
OPENAI_API_KEY=
